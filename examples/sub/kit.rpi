// ============================================================
// Rupis 示例：子目录里的零件库
// 用法：lib sub/kit   （脚本名里的 / 表示子目录）
// ============================================================

// 给信号加强
def boost(level):{
    if(level >= 15):{
        return 15
    }
    return level + 1
}

// 一个方块零件
strudef pad(v):{
    rw{rsig=v}[0,0,0]
}
